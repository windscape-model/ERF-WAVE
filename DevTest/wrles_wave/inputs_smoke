# WRLES smoke test: wall-resolved LES over the moving wave in the compressible solver.
# Smagorinsky SGS + constant molecular viscosity + orbital no-slip wall (TERRAIN_VELOCITY build).
# The stress path adds molecular and eddy viscosity (ERF_ComputeStress_T.cpp: mu_tot =
# rhoAlpha + 2*mu_turb), so the two act together. This case proves the wiring runs and
# stays finite; it is not yet a resolved-turbulence validation.
# Grid and wall setup follow the viscous Stokes deck (known-good TV wall); viscosity is
# lowered so the eddy viscosity is not negligible, and the explicit vertical-diffusion
# limit nu*dt/dz_min^2 < 1/2 still holds (0.02*0.002/0.01 = 0.004).
erf.prob_name = "Moving Terrain"
erf.init_type = Isentropic
stop_time = 1.0
max_step  = 200
amrex.fpe_trap_invalid = 1
fabarray.mfiter_tile_size = 1024 1024 1024
geometry.prob_extent = 56.2 10.  100.
amr.n_cell           =  50    8   81
geometry.is_periodic = 1 1 0
zlo.type = "NoSlipWall"
zhi.type = "SlipWall"
erf.terrain_type = MovingFittedMesh
erf.terrain_smoothing = 2
erf.substepping_type    = Implicit
erf.fixed_mri_dt_ratio  = 4
erf.use_lagged_delta_rt = false
erf.beta_s              = 0.1
erf.fixed_dt           = 0.002
erf.sum_interval = -1
erf.v = 0
amr.v = 0
amr.max_level = 0
erf.check_int   = -1
erf.plot_file_1 = plt
erf.plot_int_1  = 200
erf.plot_vars_1 = density x_velocity y_velocity z_velocity pressure theta pert_pres pert_dens detJ
erf.use_gravity = true
erf.dycore_horiz_adv_type  = Centered_2nd
erf.dycore_vert_adv_type   = Centered_2nd
erf.dryscal_horiz_adv_type = Centered_2nd
erf.dryscal_vert_adv_type  = Centered_2nd
erf.molec_diff_type = "Constant"
erf.dynamic_viscosity = 0.02
erf.rho0_trans = 1.0
erf.alpha_T = 0.0
erf.grid_stretching_ratio = 1.05
erf.initial_dz = 0.1
erf.les_type = "Smagorinsky"
erf.Cs       = 0.10
prob.custom_terrain_type = "MovingSineWave"
prob.wavelength = 56.2
prob.Ampl = 0.08
prob.T_0  = 300.
erf.substep_time_order = 1

erf.rayleigh_damping_type = FastImplicit
erf.rayleigh_damp_W = 1
erf.rayleigh_dampcoef = 200
erf.rayleigh_zdamp = 40.0

erf.vert_implicit = 0
