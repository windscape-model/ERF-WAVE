# COMPRESSIBLE twin of the anelastic validation case: identical geometry, ramp, and
# duration, run with the JCP split-explicit method (implicit substepping, midpoint
# metrics). Snapshots every 1 s feed the same two-mode fit in check_wave_solution.py;
# the oscillating mode is the cross-check for the anelastic result. Plain build.
erf.prob_name = "Moving Terrain"
erf.init_type = Isentropic
max_step  = 10000
amrex.fpe_trap_invalid = 1
fabarray.mfiter_tile_size = 1024 1024 1024
geometry.prob_extent = 100.  10.  100.
amr.n_cell           =  40    4   50
geometry.is_periodic = 1 1 0
zlo.type = "SlipWall"
zhi.type = "SlipWall"

erf.terrain_type = MovingFittedMesh
erf.terrain_smoothing = 2
prob.custom_terrain_type = "MovingSineWaveRamp"
prob.wavelength = 100.0
prob.Ampl = 0.16
prob.T_0  = 300.

erf.substepping_type    = Implicit
erf.fixed_mri_dt_ratio  = 4
erf.use_lagged_delta_rt = false
erf.beta_s              = 0.1
erf.fixed_dt            = 0.002

erf.use_gravity = true

erf.dycore_horiz_adv_type  = Centered_2nd
erf.dycore_vert_adv_type   = Centered_2nd
erf.dryscal_horiz_adv_type = Centered_2nd
erf.dryscal_vert_adv_type  = Centered_2nd
erf.molec_diff_type = "None"
erf.les_type        = "None"

erf.sum_interval = -1
erf.v = 0
amr.v = 0
amr.max_level = 0
erf.check_int   = -1
erf.plot_file_1 = plt
erf.plot_int_1  = 500
erf.plot_vars_1 = density x_velocity y_velocity z_velocity pressure theta pert_pres pert_dens dens_hse detJ z_phys
