# Anelastic + MOVING wave, code AS-IS (stage A characterization, NOT a capability).
# The current projection uses the old-step geometry (z_phys_nd, detJ_cc, ax/ay/az),
# omits the grid velocity in Omega, and has no d(J rho0)/dt source in the constraint.
# This run documents that behavior before the stage B development fixes it.
# Needs the FFT build: ERF3d.gnu.TEST.MPI.FFT.ex.
erf.prob_name = "Moving Terrain"
erf.init_type = Isentropic
max_step  = 20
amrex.fpe_trap_invalid = 1
fabarray.mfiter_tile_size = 1024 1024 1024
geometry.prob_extent = 100.  10.  100.
amr.n_cell           =  40    4   50
geometry.is_periodic = 1 1 0
zlo.type = "SlipWall"
zhi.type = "SlipWall"

erf.terrain_type = MovingFittedMesh
erf.terrain_smoothing = 2
prob.custom_terrain_type = "MovingSineWaveRamp"
prob.wavelength = 100.0
prob.Ampl = 0.16
prob.T_0  = 300.

erf.anelastic      = 1
erf.use_fft        = true
erf.poisson_reltol = 1.e-10
erf.poisson_abstol = 1.e-10
erf.mg_v           = 1

erf.fixed_dt = 0.05
erf.use_gravity = true

erf.dycore_horiz_adv_type  = Centered_2nd
erf.dycore_vert_adv_type   = Centered_2nd
erf.dryscal_horiz_adv_type = Centered_2nd
erf.dryscal_vert_adv_type  = Centered_2nd
erf.molec_diff_type = "None"
erf.les_type        = "None"

erf.sum_interval = -1
erf.v = 0
amr.v = 0
amr.max_level = 0
erf.check_int   = -1
erf.plot_file_1 = plt
erf.plot_int_1  = 20
erf.plot_vars_1 = density x_velocity y_velocity z_velocity pressure theta pert_pres pert_dens detJ z_phys
