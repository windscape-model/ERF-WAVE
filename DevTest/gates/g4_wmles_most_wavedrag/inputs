# GATE g4: miniature wall-modeled LES over the moving wave (the JCP turbulent configuration).
# Derived from Exec/wave_abl_les/inputs_wave_abl: 32x16x32 uniform grid, 30 steps.
# Protects: MOST wave-drag wall model, Smagorinsky + constant molecular viscosity (additive),
# pressure-gradient ABL forcing, log-law + perturbation initialization, order-2 coupling, sponge.
erf.prob_name        = "Moving Terrain"
erf.init_type        = Isentropic
stop_time            = 18000.0
max_step             = 30
amrex.fpe_trap_invalid = 1
fabarray.mfiter_tile_size = 1024 1024 1024

geometry.prob_extent = 200.  100.  300.
amr.n_cell           = 32    16    32
geometry.is_periodic = 1 1 0
amr.max_level        = 0

erf.terrain_type         = MovingFittedMesh
erf.terrain_smoothing    = 2
prob.custom_terrain_type = "MovingSineWaveRamp"
prob.wavelength          = 100.0
prob.Ampl                = 1.59
prob.T_0                 = 300.

prob.init_ustar          = 0.446
prob.init_z0             = 0.0002
prob.init_pert_amp       = 0.5

zlo.type           = "surface_layer"
erf.most.z0        = 0.0002
erf.most.zref      = 4.6875
erf.most.wave_drag = 1
zhi.type = "SlipWall"

erf.les_type          = "Smagorinsky"
erf.Cs                = 0.10
erf.molec_diff_type   = "Constant"
erf.dynamic_viscosity = 1.0e-2
erf.use_gravity       = true
erf.alpha_T = 0.0

erf.abl_driver_type   = "PressureGradient"
erf.abl_pressure_grad = -9.95e-4  0.  0.

erf.substepping_type   = Implicit
erf.fixed_mri_dt_ratio = 6
erf.substep_metric_sampling = midpoint
erf.beta_s             = 0.1
erf.fixed_dt           = 0.005

erf.rayleigh_damping_type = FastImplicit
erf.rayleigh_damp_W       = 1
erf.rayleigh_dampcoef     = 200.0
erf.rayleigh_zdamp        = 100.0

erf.dycore_horiz_adv_type  = Centered_2nd
erf.dycore_vert_adv_type   = Centered_2nd
erf.dryscal_horiz_adv_type = Centered_2nd
erf.dryscal_vert_adv_type  = Centered_2nd

erf.sum_interval = -1
erf.v = 0
amr.v = 0
erf.check_int   = -1
erf.plot_file_1 = plt
erf.plot_int_1  = 30
erf.plot_vars_1 = density x_velocity y_velocity z_velocity pressure theta pert_pres pert_dens detJ
